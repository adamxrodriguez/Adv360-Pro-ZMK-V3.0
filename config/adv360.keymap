#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        Jesus: Jesus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(J) &kp E &kp S &kp U &kp S>;
            label = "JESUS";
        };

        adamQ: adamQ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp D &kp A &kp M &kp AT &kp Q &kp U &kp A &kp N &kp T &kp I &kp M &kp O &kp N &kp DOT &kp C &kp O &kp M>;
            label = "ADAMQ";
        };

        deleteLine: deleteLine {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(RIGHT_ARROW) &kp RS(RG(LEFT_ARROW)) &kp BACKSPACE>;
            label = "DELETELINE";
        };

        formatSelection: formatSelection {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(K) &kp RG(F)>;
            label = "FORMATSELECTION";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1        &kp N2    &kp N3    &kp N4     &kp N5  &tog 1                                                     &mo 2      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q         &kp W     &kp F     &kp P      &kp B   &kp TAB                                                    &none      &kp J   &kp L   &kp U      &kp Y     &kp P     &kp BSLH
&kp ESC    &hm LGUI A    &kp R     &kp S     &kp T      &kp G   &kp GRAVE  &kp LGUI   &kp LCTRL      &kp RALT   &kp RGUI   &none      &kp M   &kp N   &kp E      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp X         &kp C     &kp D     &kp V      &kp B                         &kp LG(C)      &kp LG(X)                        &kp K   &kp H   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 1      &kp CAPSLOCK  &kp LALT  &kp LEFT  &kp RIGHT          &kp BSPC   &lt 1 RET  &kp LG(V)      &kp PG_DN  &lt 1 RET  &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 1
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp LG(LS(DOWN_ARROW))  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_PRV    &bt BT_NXT    &to 0                                                           &mo 2      &none           &kp KP_NUM            &kp KP_EQUAL          &kp KP_DIVIDE           &Jesus                   &adamQ
&kp TAB                 &none         &none           &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &none                                                           &none      &none           &none                 &none                 &none                   &none                    &none
&deleteLine             &none         &kp NUMBER_0    &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &none       &kp LCTRL  &kp LALT      &kp LGUI    &kp RCTRL      &none      &none           &kp RS(RG(N))         &none                 &kp RG(RA(I))           &none                    &kp SQT
&kp LSHFT               &none         &none           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3                         &kp HOME      &bt BT_CLR                            &kp LG(C_MUTE)  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none                   &kp KP_ENTER             &kp RSHFT
&none                   &kp UP_ARROW  &kp DOWN_ARROW  &bt BT_PRV    &bt BT_NXT                  &kp DELETE  &kp SPACE  &kp END       &kp PG_DN   &kp BACKSPACE  &kp SPACE                  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp RG(RA(LEFT_ARROW))  &kp RG(RA(RIGHT_ARROW))  &none
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &bt BT_CLR                               &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
